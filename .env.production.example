APP_NAME="File Import System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.com.br

# Porta publicada do nginx no host (geralmente atrás de um reverse proxy/HTTPS)
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Permissões dos volumes (IDs do usuário do servidor: id -u / id -g) ---
UID=1000
GID=1000

# --- Banco de dados (MySQL no container) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=file_import_system
DB_USERNAME=fis
# TROQUE estas senhas em produção!
DB_PASSWORD=ALTERE_ESTA_SENHA
DB_ROOT_PASSWORD=ALTERE_ESTA_SENHA_ROOT

# --- Sessão (Redis) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Habilite quando estiver atrás de HTTPS:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Filas (Redis) ---
QUEUE_CONNECTION=redis

# --- Cache (Redis) ---
CACHE_STORE=redis

# --- Redis (container) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responder@seu-dominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
